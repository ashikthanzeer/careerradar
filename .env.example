# CareerRadar — Production Environment Configuration Template
# Copy this file to .env and fill in your credentials. Never commit .env to Git.

# Frontend Configuration (apps/web)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend Configuration (apps/api)
DATABASE_URL=sqlite:///./career_intelligence.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_intelligence

ENVIRONMENT=production
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & JWT Security
JWT_SECRET_KEY=change-this-to-a-64-char-random-hex-secret-in-production
JWT_EXPIRE_MINUTES=10080

# OAuth 2.0 Provider Credentials (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback?provider=google

# Optional AI Provider Key (Server-side only)
GEMINI_API_KEY=
