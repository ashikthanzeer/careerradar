# CareerRadar — Production Environment Configuration Template
# Copy this file to .env for local development. Never commit .env to Git.
# For separated deployments, set Frontend variables on your static web host (e.g. Vercel / Netlify)
# and Backend variables on your API server host (e.g. Render / Railway / Fly.io / Cloud Run).

# ==============================================================================
# 1. FRONTEND DEPLOYMENT VARIABLES (apps/web — Public Browser Bundle via Vite)
#    WARNING: Never put secrets or API keys in VITE_* variables.
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Production example: VITE_API_BASE_URL=https://api.your-domain.com/api/v1
# Optional data source mode: hybrid | api | mock (defaults to hybrid)
# VITE_DATA_MODE=hybrid

# ==============================================================================
# 2. BACKEND DEPLOYMENT VARIABLES (apps/api — FastAPI Server Only)
# ==============================================================================

# Database (Local SQLite default; Neon / managed PostgreSQL in production)
DATABASE_URL=sqlite:///./career_intelligence.db
DIRECT_URL=sqlite:///./career_intelligence.db
# For PostgreSQL / Neon in production:
# DATABASE_URL=postgresql://user:password@your-pooler-host/neondb?sslmode=require
# DIRECT_URL=postgresql://user:password@your-direct-host/neondb?sslmode=require

# Runtime & CORS
ENVIRONMENT=production
FRONTEND_URL=http://localhost:5173
# Production example: FRONTEND_URL=https://careerradar-web.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://careerradar-web.vercel.app

# Authentication & JWT Security
JWT_SECRET_KEY=change-this-to-a-64-char-random-hex-secret-in-production
JWT_EXPIRE_MINUTES=43200

# OAuth 2.0 Provider Credentials (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback?provider=google
# Production example: GOOGLE_REDIRECT_URI=https://careerradar-web.vercel.app/auth/callback

# Optional AI Provider Configuration (Groq — Server-side only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
